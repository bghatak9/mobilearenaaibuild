# Base URL of the MobileArena REST API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional analytics (e.g. Plausible). Leave unset to disable.
# NEXT_PUBLIC_ANALYTICS_SRC="https://plausible.io/js/script.js"
# NEXT_PUBLIC_ANALYTICS_DOMAIN="mobilearena.example.com"

# Optional endpoint to receive Core Web Vitals beacons. Leave unset to disable.
# NEXT_PUBLIC_VITALS_ENDPOINT="https://example.com/api/vitals"
