# Browser / client: use same-origin proxy (next.config.js rewrites /api → backend).
NEXT_PUBLIC_API_URL=/api

# Server-side fetches + Next rewrite target (NestJS).
BACKEND_URL=http://localhost:4000

# Optional — dev-only direct backend for admin bulk uploads (multipart-safe).
# NEXT_PUBLIC_DEV_API_URL=http://localhost:4000

# Public site origin for SEO canonical URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — public social profile URLs (header / footer icons)
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/MobileArena
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@MobileArena
# NEXT_PUBLIC_X_URL=https://x.com/MobileArena
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mobilearena

# Optional — Google/Facebook OAuth IDs are normally loaded from GET /auth/social-config
# using the backend GOOGLE_CLIENT_ID and FACEBOOK_APP_ID. Set these only if you need
# build-time overrides (e.g. static export without the API).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_FACEBOOK_APP_ID=
