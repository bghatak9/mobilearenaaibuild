# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://mobilearena:mobilearena123@localhost:5432/mobilearena_db?schema=public"

# Secret used to sign JWT access tokens.
JWT_SECRET="change-me-in-production"

# Redis connection string for API response caching (optional — the API runs
# without it, just without caching).
REDIS_URL="redis://localhost:6379"

# Optional Sentry error tracking. Leave unset to disable (no-op).
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Seed script — staff accounts (passwords hashed at seed time only; never stored plain text).
# SUPER_ADMIN_EMAIL="superadmin@mobilearena.com"
# SUPER_ADMIN_PASSWORD="SuperAdmin123!"
# ADMIN_EMAIL="admin@mobilearena.com"
# ADMIN_PASSWORD="Admin123!"
# EDITOR_EMAIL="editor@mobilearena.com"
# EDITOR_PASSWORD="Editor123!"
# AUTHOR_EMAIL="author@mobilearena.com"
# AUTHOR_PASSWORD="Author123!"
# MODERATOR_EMAIL="moderator@mobilearena.com"
# MODERATOR_PASSWORD="Moderator123!"
# TEST_ADMIN_EMAIL="testadmi@mobilearena.com"
# TEST_ADMIN_PASSWORD="TestAdmi123!"

# Google Sign-In — set GOOGLE_CLIENT_ID on the backend; the frontend loads it via GET /auth/social-config.
# Also add your site origin under "Authorized JavaScript origins" in Google Cloud Console.
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Optional frontend build-time override (usually not needed):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Facebook Sign-In — backend needs FACEBOOK_APP_ID + FACEBOOK_APP_SECRET; frontend loads app ID via /auth/social-config.
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# NEXT_PUBLIC_FACEBOOK_APP_ID=""

# Local development: show Google/Facebook buttons without OAuth credentials (email prompt).
SOCIAL_AUTH_DEV_MODE="true"

# Optional Google Cloud Translation API key for multilingual voice search.
# Enable "Cloud Translation API" in Google Cloud Console.
# GOOGLE_TRANSLATE_API_KEY=""

# Optional OpenAI API key for AI spam scoring on community comments.
# AI_SPAM_ENABLED="true"
# OPENAI_API_KEY=""
# AI_SPAM_MODEL="gpt-4o-mini"
# AI_SPAM_AUTO_REMOVE_THRESHOLD="85"

# Expose OTP codes in API responses / logs during development.
# OTP_DEV_EXPOSE="true"

# Testing: public catalog shows only bulk-uploaded phones (hides seed/demo data).
# CATALOG_IMPORTED_ONLY="true"

# Skip demo device rows when running `npm run prisma:seed`.
# SKIP_DEVICE_SEED="true"

# Public news API shows only bulk-uploaded articles when CATALOG_IMPORTED_ONLY is true.
# Re-import news after enabling so articles get an importBatchId.
