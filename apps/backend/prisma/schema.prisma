// MobileArena database schema.
// Mirrors the "Complete Production Blueprint" data model: devices and their
// specification tables (display, battery, chipset, cameras, images), plus the
// review/news CMS, ratings, comments and user/role system.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  EDITOR
  WRITER
  USER
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  comments Comment[]
  ratings  Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id   Int     @id @default(autoincrement())
  name String  @unique
  slug String  @unique
  logo String?

  devices Device[]
}

model Manufacturer {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  country     String?
  website     String?
  logo        String?
  description String?

  devices Device[]
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?

  devices Device[]
}

model Device {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String
  price         Float?
  announcedDate DateTime?
  releasedDate  DateTime?
  weight        Float?
  dimensions    String?
  os            String?
  waterproof    Boolean?
  fiveG         Boolean?
  nfc           Boolean?
  infrared      Boolean?
  fingerprint   String?
  rating        Float?

  brandId        Int
  categoryId     Int
  manufacturerId Int

  brand        Brand        @relation(fields: [brandId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  display Display?
  battery Battery?
  chipset Chipset?

  cameras  Camera[]
  images   DeviceImage[]
  reviews  Review[]
  ratings  Rating[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([manufacturerId])
}

model Display {
  id          Int     @id @default(autoincrement())
  type        String
  size        Float
  resolution  String
  refreshRate Int
  brightness  Int
  protection  String?

  deviceId Int    @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Battery {
  id       Int     @id @default(autoincrement())
  capacity Int
  charging String
  wireless Boolean @default(false)
  reverse  Boolean @default(false)

  deviceId Int    @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Chipset {
  id          Int    @id @default(autoincrement())
  cpu         String
  gpu         String
  fabrication String
  benchmark   Int?

  deviceId Int    @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Camera {
  id            Int     @id @default(autoincrement())
  type          String
  megapixel     Int
  aperture      String?
  opticalZoom   String?
  stabilization Boolean @default(false)

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model DeviceImage {
  id        Int     @id @default(autoincrement())
  url       String
  thumbnail String?
  type      String

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model Review {
  id      Int    @id @default(autoincrement())
  title   String
  slug    String @unique
  content String
  score   Float
  pros    Json
  cons    Json

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deviceId])
}

model News {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  thumbnail   String?
  featured    Boolean    @default(false)
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
}

model Rating {
  id    Int   @id @default(autoincrement())
  score Float

  userId   Int
  deviceId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
}

model Comment {
  id   Int    @id @default(autoincrement())
  body String

  userId   Int
  deviceId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
}
