{
  "name": "mobilearena",
  "version": "1.0.0",
  "private": true,
  "description": "MobileArena — smartphone discovery platform (monorepo)",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run start:dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend -- -H 0.0.0.0 -p 3000",
    "build:backend": "npm run build --workspace apps/backend",
    "build:frontend": "npm run build --workspace apps/frontend",
    "prisma:generate": "npm run prisma:generate --workspace apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/backend"
  }
}
